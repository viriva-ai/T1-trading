# Copy to ~/.config/t1/env (chmod 600), NOT into the repo. Loaded by deploy/run.sh.
# Kite Connect app credentials (developers.kite.trade -> My apps). Never commit real values.
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Optional
T1_CONFIG=/home/ubuntu/T1-trading/config/config.yaml
# T1_DATA_DIR=/home/ubuntu/t1-data
# T1_STATE_DIR=/home/ubuntu/t1-state
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Only for live trading, and only after reading docs/LIVE_TRADING.md:
# T1_LIVE_CONFIRM=
